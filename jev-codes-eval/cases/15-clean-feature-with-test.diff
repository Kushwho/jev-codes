@@ -0,0 +1,6 @@
+import { isWeekend } from './isWeekend';
+
+export function isBusinessDay(date: Date, holidays: ReadonlySet<string> = new Set()): boolean {
+  if (isWeekend(date)) return false;
+  return !holidays.has(date.toISOString().slice(0, 10));
+}

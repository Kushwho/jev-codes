@@ -0,0 +1,16 @@
+import { describe, expect, it } from 'vitest';
+import { isBusinessDay } from './isBusinessDay';
+
+describe('isBusinessDay', () => {
+  it('is false on a Saturday', () => {
+    expect(isBusinessDay(new Date('2026-09-19T00:00:00Z'))).toBe(false);
+  });
+
+  it('is true on a Monday with no holidays', () => {
+    expect(isBusinessDay(new Date('2026-09-21T00:00:00Z'))).toBe(true);
+  });
+
+  it('is false on a listed holiday', () => {
+    expect(isBusinessDay(new Date('2026-10-02T00:00:00Z'), new Set(['2026-10-02']))).toBe(false);
+  });
+});
diff --git a/src/dates/isBusinessDay.ts b/src/dates/isBusinessDay.ts
